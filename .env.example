# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (database: nabavaradar) ---
POSTGRES_PASSWORD=change-me

# --- Identification towards external sources (used in the HTTP User-Agent) ---
CONTACT_EMAIL=marko.subasic@susfer.hr

# --- SMTP (dev: Mailpit on 127.0.0.1:1025; production: a real SMTP relay with STARTTLS on 587) ---
# Use 127.0.0.1, not "localhost": compose publishes IPv4 only and "localhost" can stall for
# ~40 s per connection on Windows while IPv6 (::1) is tried first.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# --- Public host name used by Caddy in production (TLS certificate is issued for it) ---
NABAVA_HOST=birokratko.localhost

# --- Core settings (read by opendata_core.config.CoreSettings) ---
APP_NAME=nabavaradar
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/nabavaradar
HTTP_CACHE_DIR=.http-cache
HTTP_TIMEOUT_S=20
NOMINATIM_URL=https://nominatim.openstreetmap.org
PUBLIC_BASE_URL=http://localhost:5173

# --- Release metadata (set by CI / deploy) ---
GIT_SHA=dev

# Per-IP request budget of the API (slowapi syntax); raise it when many users share one IP
RATE_LIMIT=60/minute

# --- Sudski registar API (see apps/nabavaradar/.env.example for details) ---
# Credentials end with ".."; confirm the e-mail on the portal first (else HTTP 401 on data calls)
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=
SUDREG_BASE_URL=https://sudreg-data.gov.hr/api/javni
SUDREG_TOKEN_URL=https://sudreg-data.gov.hr/api/oauth/token
# Signs unsubscribe/settings tokens; required by docker-compose.prod.yml (e.g. `openssl rand -hex 32`)
SUBSCRIPTION_SECRET=
